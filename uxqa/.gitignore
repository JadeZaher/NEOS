# ux-qa-research: secrets and raw captures never leave the machine
.secrets/
passes/*/runs/
passes/*/flows/
# NEOS study: harness deps and the generated route shadow (rebuild with adapter/gen-routes.mjs)
node_modules/
routes/
# pass args are derived (study.md + prior ledger); rebuild with adapter/pass-args.mjs
passes/*/args.json
# agent-eval transcripts are raw captures (no secrets, but large); the summary lives in agent-eval.json
passes/*/agent-evals/
